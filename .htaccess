Options -Indexes
DirectoryIndex index.php

# Keep secrets, code-only folders and migrations off the web.
<FilesMatch "^(config\.php|config\.sample\.php|schema.*\.sql|README\.md|CLAUDE\.md|\.cpanel\.yml|error_log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|cron)(/|$) - [F,L]
    RewriteRule ^\.git - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
